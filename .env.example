# Vercel Postgres / Neon connection string
POSTGRES_URL=postgresql://user:password@host/database?sslmode=require

# Vercel Blob token (optional locally; falls back to uploads/avatars)
BLOB_READ_WRITE_TOKEN=
# Must match the Blob store access mode: private or public
BLOB_ACCESS=private

# URL of the neural prediction server used by the embedded chessboard
CHESS_API_BASE=http://localhost:8000

# Shared secret used to sign completed-game result tickets
CHESS_RESULT_SECRET=replace-with-a-long-random-value
